    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "stylelint": "stylelint \"src/**/*.{vue,css,scss}\"",
    "stylelint:fix": "stylelint --fix \"src/**/*.{vue,css,scss}\""
